# Server environment variables: copy to server/.env for local dev.
# On Vercel, set these in Project Settings → Environment Variables instead. All are optional.
GOOGLE_CIVIC_API_KEY=your_google_civic_api_key_here
NEWS_API_KEY=your_newsapi_key_here
# Optional Postgres cache (not needed on Vercel; the CDN caches API responses)
DATABASE_URL=
CLIENT_URL=http://localhost:5173
PORT=3001

# Client build variable: only for native/mobile app builds, which have no same-origin API.
# VITE_API_BASE=https://vote4ucyl.vercel.app
